# Copy to .env (outside the public directory) and adjust.
# Never commit .env. Production values belong only on the server.

# local | production
APP_ENV=local
# Show PHP errors in the browser. Must be false in production.
APP_DEBUG=true
# Full public URL of the application, without a trailing slash.
# XAMPP subfolder example: http://localhost/AtlanticCustomerQueries
# Hostinger example:       https://inquiries.example.com
APP_URL=http://localhost/AtlanticCustomerQueries
APP_NAME="Inquiry Manager"

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=atlantic_inquiries
DB_USER=root
DB_PASS=

# Separate database used only by tests/run.php. It is dropped and recreated.
DB_TEST_NAME=atlantic_inquiries_test

# Session cookie. Set SESSION_SECURE=true whenever the site is served over HTTPS.
SESSION_SECURE=false
SESSION_IDLE_MINUTES=480
# "Remember me" on the sign-in page keeps a device signed in for this many days (0 = off).
REMEMBER_DAYS=30

# API: reject plain HTTP submissions (keep true in production).
API_REQUIRE_HTTPS=false
# Maximum JSON body size in bytes for POST /api/v1/submissions.
API_MAX_BODY_BYTES=65536
# Requests per minute allowed from one IP before authentication.
API_IP_LIMIT_PER_MINUTE=300

# Comma-separated proxy IPs whose X-Forwarded-For / X-Forwarded-Proto headers are trusted.
# Leave empty on Hostinger unless you put a CDN/proxy in front of the app.
TRUSTED_PROXIES=

# Days to keep technical API diagnostics before pruning.
DIAGNOSTICS_RETENTION_DAYS=30
